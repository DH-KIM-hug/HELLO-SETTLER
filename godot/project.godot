; Engine configuration file.
; 나의 작은 지구 (나작지) — Godot 4.7.2, GDScript. 안내: docs/GODOT_KICKOFF.md

config_version=5

[application]

config/name="Nazakji"
config/description="나의 작은 지구 — 유리병 속 작은 중세 문명"
run/main_scene="res://scenes/test_village.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
