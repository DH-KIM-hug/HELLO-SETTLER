; Engine configuration file.
; 나의 작은 지구 (나작지) — Godot 4.7.2, GDScript. 안내: docs/GODOT_KICKOFF.md

config_version=5

[application]

config/name="Nazakji"
config/icon="res://art/icon/icon_512.png"
config/description="나의 작은 지구 — 유리병 속 작은 중세 문명"
config/version="0.1.0"
run/main_scene="res://scenes/test_village.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

; 소리·음악 (docs/AUDIO.md) — 화면 코드는 GameAudio의 정적 함수로 부른다 (자동 로드가 없으면 조용히 넘어감)
AudioManager="*res://view/audio_manager.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

; 손가락 → 흉내 마우스는 켜 둔다 (UI 버튼이 눌리게). 세계 화면은 흉내 마우스를 버리고 손가락 사건만 쓴다 (view/test_village.gd _unhandled_input).
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
