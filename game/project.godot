; Engine configuration file.
; spirit-guests (working title) — 0.0 prototype, Godot 4.7.2, GDScript.
; Data lives in res://data/*.json. Sim code lives in res://sim/.

config_version=5

[application]

config/name="spirit-guests (working title)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NanumSquareRoundR.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="ko"
locale/translations=PackedStringArray("res://data/text/ko.ko.translation")

[rendering]

renderer/rendering_method="mobile"
